# Azure OCR Service Configuration
AZURE_OCR_API_KEY=your_azure_ocr_api_key
AZURE_OCR_ENDPOINT=https://your-ocr-service.cognitiveservices.azure.com/

# Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=yourstoragekey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=uploads

# Application Configuration
DEBUG=False
PORT=8080
